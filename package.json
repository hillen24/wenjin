{
  "name": "wenjin",
  "version": "3.3.0",
  "private": true,
  "description": "问津 · 思想栖所 —— 哲学学习应用（电脑端 + 手机端）",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:desktop": "npm run dev --workspace @wenjin/desktop",
    "build:desktop": "npm run build --workspace @wenjin/desktop",
    "dist:desktop": "npm run dist --workspace @wenjin/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
